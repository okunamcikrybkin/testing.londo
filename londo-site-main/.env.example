# Copy to `.env.local` and fill in real values. Do not commit secrets.

DATABASE_URL=
AUTH_SECRET=
# Optional dedicated key for staff PINs. If empty, AUTH_SECRET is used with a separate derivation label.
STAFF_PIN_PEPPER=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Discord bot integration for family applications. Keep all values private.
DISCORD_BOT_TOKEN=
DISCORD_BOT_API_SECRET=
# Internal secret for normalized events from the separate LONDO bot.
LONDO_BOT_API_SECRET=
LONDO_BOT_INTERNAL_URL=http://127.0.0.1:3101
# Public key from Discord Developer Portal, used to verify signed interactions.
DISCORD_APPLICATION_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_RECRUIT_ROLE_IDS=
DISCORD_HIGH_STAFF_ROLE_IDS=
FULL_ACCESS_DISCORD_IDS=""

MEMPHIS_APPLICATION_CATEGORY_ID=
MEMPHIS_STAFF_ROLE_IDS=
MEMPHIS_ACCEPT_ROLE_IDS=

PHOENIX_APPLICATION_CATEGORY_ID=
PHOENIX_STAFF_ROLE_IDS=
PHOENIX_ACCEPT_ROLE_IDS=

# Website applications / Discord checks
PUBLIC_SITE_URL=
DISCORD_OAUTH_ENCRYPTION_KEY=

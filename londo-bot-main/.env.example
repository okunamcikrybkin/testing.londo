# Скопируйте файл в .env и укажите нужные секреты и настройки.
# Секретный токен бота из Discord Developer Portal.
DISCORD_BOT_TOKEN=""
# ID Discord-сервера, в котором работает бот.
DISCORD_GUILD_ID=""

# ID роли семьи MEMPHIS (Discord Snowflake).
MEMPHIS_ROLE_ID=""
# ID общей роли семьи (Discord Snowflake).
FAM_ROLE_ID=""

# ID текстового канала с панелью временных комнат.
TEMPORARY_VOICE_PANEL_CHANNEL_ID=""
# ID голосового канала, вход в который создаёт временную комнату.
TEMPORARY_VOICE_TRIGGER_CHANNEL_ID=""
# ID категории для временных голосовых комнат.
TEMPORARY_VOICE_CATEGORY_ID=""

# Адрес сайта для отправки журналов и синхронизации; пусто отключает связь с сайтом.
LONDO_SITE_URL=""
# Общий секрет API между ботом и сайтом; задайте такое же значение в .env.local сайта.
LONDO_BOT_API_SECRET=""
# ID канала, куда приходят запросы доступа к сайту.
ACCESS_REQUEST_CHANNEL_ID=""

# Роли рангов для синхронизации, доступа и профилей.
OWNER_ROLE_ID=""
MEMPHIS_DEP_OWNER_ROLE_ID=""
MEMPHIS_HIGH_STAFF_ROLE_ID=""
MEMPHIS_CUR_RECRUIT_ROLE_ID=""
MEMPHIS_RECRUIT_ROLE_ID=""
MAIN_ROLE_ID=""
LONDEST_LONDO_ROLE_ID=""
LONDO_ROLE_ID=""
YOUNG_LONDO_ROLE_ID=""
BABY_LONDO_ROLE_ID=""
NEWBIE_ROLE_ID=""
NICKNAME_GUARD_EXEMPT_ROLE_IDS=""

# ID Discord-канала, в котором публикуется панель заявок.
APPLICATION_CHANNEL_ID=""
# ID категории Discord, куда помещаются каналы звонков по заявкам.
APPLICATION_CALL_CATEGORY_ID=""
# ID ролей сотрудников MEMPHIS через запятую.
MEMPHIS_STAFF_ROLE_IDS=""
# ID ролей, выдаваемых принятым участникам MEMPHIS, через запятую.
MEMPHIS_ACCEPT_ROLE_IDS=""
# Необязательный ID эмодзи для выбора MEMPHIS в форме заявок; пусто — без эмодзи.
MEMPHIS_APPLICATION_EMOJI_ID=""
# Порт внутреннего API бота для сайта; по умолчанию 3101.
LONDO_BOT_INTERNAL_PORT="3101"
LONDO_BOT_HOST="127.0.0.1"
# ID голосового канала AFK для отслеживания голосовой активности.
FAMILY_AFK_CHANNEL_ID=""

# Необязательный ID текстового канала для таблицы лидеров.
LEADERBOARD_CHANNEL_ID=""
# ID уже опубликованного сообщения таблицы лидеров; пусто при первой настройке.
LEADERBOARD_MESSAGE_ID=""

# Необязательный ID канала для приветствий при входе участников.
WELCOME_CHANNEL_ID=""

# Необязательный ID канала, где публикуется путеводитель.
GUIDE_CHANNEL_ID=""
# ID уже опубликованного сообщения путеводителя; пусто при первой настройке.
GUIDE_MESSAGE_ID=""
# ID канала навигации, указанного в путеводителе.
NAVIGATION_CHANNEL_ID=""
# ID канала с видео, указанного в путеводителе.
VIDEOS_CHANNEL_ID=""
# ID канала новостей, указанного в путеводителе.
NEWS_CHANNEL_ID=""
# ID текстового чата для гостей, указанного в путеводителе.
GUEST_CHAT_CHANNEL_ID=""
# ID голосового канала для гостей, указанного в путеводителе.
VOICE_GUEST_CHANNEL_ID=""
# Ссылка на подачу заявки для путеводителя.
GUIDE_APPLICATION_URL=""
# Ссылка на регистрацию для путеводителя.
GUIDE_REGISTRATION_URL=""
# Ссылка на правила для путеводителя.
GUIDE_LAW_URL=""
# Ссылка на Telegram для путеводителя.
GUIDE_TELEGRAM_URL=""
# Имя владельца сервера, отображаемое в путеводителе.
GUIDE_OWNER_NAME=""

# Client ID приложения Twitch; вместе с секретом и Discord-каналом включает отслеживание стримов.
TWITCH_CLIENT_ID=""
# Секрет приложения Twitch из Twitch Developer Console.
TWITCH_CLIENT_SECRET=""
# ID Discord-канала, куда бот отправляет объявления о стримах.
TWITCH_STREAM_CHANNEL_ID=""
# ID роли для упоминания в объявлении; пусто — использовать FAM_ROLE_ID.
TWITCH_FAM_MENTION_ROLE_ID=""

# Общий ID роли, которой разрешено подавать заявки на AFK-статус.
FAMILY_HOLIDAY_ROLE_ID=""
# Необязательная роль для отпусков MEMPHIS; пусто — использовать FAMILY_HOLIDAY_ROLE_ID.
MEMPHIS_HOLIDAY_ROLE_ID=""

# Роль и канал поздравлений с днём рождения.
BIRTHDAY_ROLE_ID=""
BIRTHDAY_CHANNEL_ID=""

# Необязательный канал уведомлений сайта при создании начальных настроек.
MEMPHIS_NOTIFICATION_CHANNEL_ID=""

# Публичный адрес сайта, используемый в ссылках на подачу заявок.
PUBLIC_SITE_URL=
# ID существующего сообщения панели заявок, если её нужно привязать к нему.
APPLICATION_PANEL_MESSAGE_ID=

# Site <-> bot deployment settings. The bot internal API port is configured above;
# the site calls it on localhost:3101 when both services share a host.
LONDO_BOT_INTERNAL_URL="http://127.0.0.1:3101"
LONDO_BOT_API_SECRET="<same-64-char-secret-in-site-and-bot>"
DATABASE_URL="postgresql://bothost_db_261a626e93e6:<password>@node1.pghost.ru:16256/bothost_db_261a626e93e6"
AUTH_SECRET="<64-char-random-secret>"
DISCORD_APPLICATION_PUBLIC_KEY="<discord-application-public-key>"
DISCORD_OAUTH_ENCRYPTION_KEY="<64-hex-char-random-key>"
DISCORD_BOT_API_SECRET="<same-value-as-LONDO_BOT_API_SECRET>"
DISCORD_RECRUIT_ROLE_IDS=""
DISCORD_HIGH_STAFF_ROLE_IDS=""
FULL_ACCESS_DISCORD_IDS=""
MEMPHIS_APPLICATION_CATEGORY_ID=""
STAFF_PIN_PEPPER="<64-char-random-secret>"
